rules_version = '2';

// Cada conta Google só lê e grava a própria pasta: users/{uid}/...
// Cole este conteúdo no console do Firebase: Firestore Database › Regras › Publicar.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
